app:
  name: go-admin
  mode: development
  port: 8081
  version: 1.0.0

log:
  level: debug
  filename: logs/app.log
  max_size: 100
  max_age: 7
  max_backups: 10

mysql:
  host: localhost
  port: 3306
  user: root
  password: your-password
  dbname: go_admin
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600

redis:
  host: localhost
  port: 6379
  password: your-password
  db: 0
  pool_size: 100
  min_idle_conns: 10
  max_retries: 3
  dial_timeout: 5
  read_timeout: 3
  write_timeout: 3

jwt:
  secret: your-secret-key
  expire: 86400

admin:
  username: admin
  password: admin123
  email: admin@example.com

nacos:
  host: localhost
  port: 8848
  namespace: public
  group: DEFAULT_GROUP
  data_id: go-admin
  username: nacos
  password: nacos 