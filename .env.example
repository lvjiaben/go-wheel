# .env 配置文件
# key 格式与 config.yaml 路径一致，使用 . 分隔层级

# 应用配置
app.name=FrameWork
app.mode=release
app.port=8801
app.version=1.0.0
app.max_request_body=10

# 日志配置
log.level=info
log.filename=runtime.log
log.max_size=200
log.max_backups=7
log.max_age=30

# 数据库配置
database.driver=mysql
database.host=127.0.0.1
database.port=3306
database.user=root
database.pass=your_password
database.dbname=go_admin
database.charset=utf8mb4
database.sslmode=disable
database.timezone=Asia/Shanghai
database.max_open_conns=100
database.max_idle_conns=20
database.max_lifetime=3600
database.max_idle_time=1800

# Redis配置
redis.state=true
redis.host=127.0.0.1
redis.port=6379
redis.pass=
redis.db=0
redis.pool_size=100
redis.min_idle_conns=10

# RabbitMQ配置（可选）
rabbitmq.state=false
rabbitmq.host=127.0.0.1
rabbitmq.port=5672
rabbitmq.virtual_host=/
rabbitmq.user=guest
rabbitmq.pass=guest
rabbitmq.queue_name=go-admin
rabbitmq.delay_queue_name=go-admin-delay
rabbitmq.exchange=go-admin-exchange
rabbitmq.delay_exchange=go-admin-delay-exchange

# JWT配置
jwt.secret=your_jwt_secret
jwt.expire_day=7
jwt.issuer=go-admin

# 后台配置
admin.login_failures=3
admin.login_failures_second=3600
admin.login_sso=true

# API配置
api.login_sso=true

# 上传配置
upload.type=local
upload.base_url=http://127.0.0.1:8801
upload.upload_path=/public/uploads
upload.max_size=10485760

# 阿里云OSS配置（upload.type=oss 时使用）
upload.oss.endpoint=
upload.oss.access_key_id=
upload.oss.access_key_secret=
upload.oss.bucket_name=

# 七牛云配置（upload.type=qiniu 时使用）
upload.qiniu.region=
upload.qiniu.access_key=
upload.qiniu.secret_key=
upload.qiniu.bucket=

# 腾讯云COS配置（upload.type=cos 时使用）
upload.cos.secret_id=
upload.cos.secret_key=
upload.cos.region=
upload.cos.bucket=
